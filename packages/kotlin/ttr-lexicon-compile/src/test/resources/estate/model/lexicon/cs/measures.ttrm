package estate

model lexicon locale cs

// The TTR-M sugar surface of the DECLARED layer (grammar 4.4), laid out the way hartland
// lays it out: model/lexicon/<locale>/*.ttrm.

def term customer_cs {
    description: "zákazník synonyma"
    for: er.entity.customer
    forms: ["zákazník", "odběratel"]
}

def term ghost_cs {
    description: "targets an object nobody defined — RV-20 drops it with a warning"
    for: er.entity.ghost
    forms: ["duch"]
}

def example ex_customers_cs {
    for: er.entity.customer
    text: "Kolik máme zákazníků?"
}

// RV-P3.4 — an md target in the DECLARED layer. This is the shape hartland's whole measure
// vocabulary uses, and every row of it compiled to nothing until the md index landed.
def term revenue_cs {
    description: "tržba synonyma — md.measure.<name>, the kinded shape"
    for: md.measure.revenue
    forms: ["tržba", "obrat"]
}
