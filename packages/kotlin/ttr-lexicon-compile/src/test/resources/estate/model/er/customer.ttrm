model er

// A plain model unit. The sugar extractor must ignore it — `model er`, not `model lexicon`.
//
// RV-P3.1 T7: this file now carries the labels and members that `EstateBuildSpec` hand-builds in
// Kotlin, because the CLI loads this estate's model FROM DISK. Until the CLI existed nothing ever
// read it, so it had drifted into a stub: the estate's own `values/status.lex.yaml` row had no
// member to resolve to and was dropped as dangling. It also settled the ref SHAPE — a loaded
// attribute is `er.entity.customer.status`, never `er.attribute.status`; the fixture's YAML had
// been authored against the latter, which no real model produces.
// `labelPlural` is deliberately something NOBODY declares, so the estate has at least one
// METADATA-only row and "the metadata layer rides along unauthored" (RV-39) is observable
// rather than merely asserted — every other label here merges with a declared row.
def entity customer { displayLabel: { cs: "Odběratel", en: "Customer" }, labelPlural: "odběratelé",
    attributes: [
        def attribute status { type: int, valueLabels: { "1": { cs: "Aktivní" } }, },
    ]
}

// MH T1 — the collision fixture, shared by BOTH twins (`RG-LEXC-004` here,
// `ttr/lexicon-form-collides-with-name` in `@tatrman/lint`). `store` owns the word
// "prodejna" through its label; `model/lexicon/cs/measures.ttrm` pins the same word to
// `store_sales` as a channel alias. One estate, one collision, two implementations that
// must agree about it. (The relation between them arrives with MH-P0·S3.)
def entity store { displayLabel: { cs: "Prodejna" },
    attributes: [
        def attribute store_id { type: int },
    ]
}

def entity store_sales {
    attributes: [
        def attribute amount { type: decimal },
    ]
}
