package dfp.worlds
model world

// The ai-platform rule-engine world (AG C-11): one SQL Server engine (the ERP DB) under the
// read-only `aip` executor — params + run-date, no store/retries/on-failure.
def world platform {
    description: "aip fixture: mssql-2019 engine under the aip executor"
    def engine erp { type: mssql, version: "2019" }
    def executor aip { type: aip }
    // `hosts: [dfp]` — the dfp package tree. ttr-metadata's hosts check matches a literal `/<pkg>/` path
    // segment, so a dotted package (`dfp.obchod`) is never found (F-AG); the root segment is.
    def storage erp_db { type: mssql, via: erp, hosts: [dfp] }
}
