package globex.obchod
def entity zakázka { description: "Zakázka", nameAttribute: číslo_zakázky, binding: { target: { query: db.query.zakázka__filter } },
    attributes: [
        def attribute id_zakázky { type: int, isKey: true, binding: IDHDOK, },
        def attribute číslo_zakázky { type: text, optional: true, binding: CIS_DOK, },
        def attribute id_subjektu { type: int, optional: true, binding: IDSUBJEKT, },
        def attribute stav_zakázky { type: int, optional: true, binding: VLSTAVHDOK, },
    ]
}

def entity řádek_zakázky { description: "Řádek zakázky", binding: { target: { table: db.dbo.QSDOK_ZAK } },
    attributes: [
        def attribute id_řádku_zakázky { type: int, isKey: true, binding: IDSDOK, },
        def attribute id_zakázky { type: int, optional: true, binding: IDHDOK, },
        def attribute id_artiklu { type: int, optional: true, binding: IDZBOZI, },
        def attribute množství { type: float, optional: true, binding: MNCELKEMPOCET, },
    ]
}

def entity zásoba_na_skladě { description: "Zásoba", binding: { target: { table: db.dbo.QZBOZSKL } },
    attributes: [
        def attribute id_artiklu { type: int, isKey: true, binding: IDZBOZI, },
        def attribute kód_skladu { type: text, optional: true, binding: CIS_SKLAD, },
        def attribute disponibilní_pro_ověření { type: float, optional: true, binding: DISPONIBILNI, },
    ]
}

def relation řádek_zakázka { description: "Řádek patří k zakázce", from: er.entity.řádek_zakázky, to: er.entity.zakázka, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.řádek_zakázky.id_zakázky, to: er.entity.zakázka.id_zakázky }],
}
